# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file WILL be committed to version control — NEVER put real secrets here,
# only placeholders.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth — generate one with: npx auth secret
AUTH_SECRET=""

# Prisma (MongoDB — schema.prisma uses mongodb, not sqlite)
DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/appzeno?retryWrites=true&w=majority"

# Bootstrap superadmin — DB-independent login for the owner account.
# Mobile identifier + BASE64-ENCODED BCRYPT HASH of the password (never plaintext,
# and never a raw bcrypt hash: the `$` chars would be eaten by Next.js .env expansion).
# Generate with: node -e "console.log(Buffer.from(require('bcryptjs').hashSync('YourStrongPass@123', 12), 'utf8').toString('base64'))"
SUPERADMIN_MOBILE="9000000001"
SUPERADMIN_PASSWORD_HASH_B64="REPLACE_WITH_BASE64_OF_BCRYPT_HASH"

# UploadThing — category hero photos. Get the secret from the UploadThing dashboard -> API Keys.
UPLOADTHING_SECRET=""

# Omnipost subscriber.confirmed webhook (agents list) — server-side only.
# JSON map of list UUID -> per-list secret; UUID(s) that mean agent registration.
OMNIPOST_LIST_SECRETS='{"<agents-list-uuid>":"<per-list-secret>"}'
OMNIPOST_AGENT_LIST_UUIDS="<agents-list-uuid>"
