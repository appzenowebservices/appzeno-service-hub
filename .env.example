# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file WILL be committed to version control — NEVER put real secrets here,
# only placeholders.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth — generate one with: npx auth secret
AUTH_SECRET=""

# Prisma (MongoDB — schema.prisma uses mongodb, not sqlite)
DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/appzeno?retryWrites=true&w=majority"

# Bootstrap superadmin — DB-independent login for the owner account.
# Mobile identifier + BASE64-ENCODED BCRYPT HASH of the password (never plaintext,
# and never a raw bcrypt hash: the `$` chars would be eaten by Next.js .env expansion).
# Generate with: node -e "console.log(Buffer.from(require('bcryptjs').hashSync('YourStrongPass@123', 12), 'utf8').toString('base64'))"
SUPERADMIN_MOBILE="9000000001"
SUPERADMIN_PASSWORD_HASH_B64="REPLACE_WITH_BASE64_OF_BCRYPT_HASH"

# UploadThing — category hero photos. Get the secret from the UploadThing dashboard -> API Keys.
UPLOADTHING_SECRET=""

# Omnipost subscriber.confirmed webhook (agents list) — server-side only.
# JSON map of list UUID -> per-list secret; UUID(s) that mean agent registration.
OMNIPOST_LIST_SECRETS='{"<agents-list-uuid>":"<per-list-secret>"}'
OMNIPOST_AGENT_LIST_UUIDS="<agents-list-uuid>"
OMNIPOST_VENDOR_LIST_UUIDS="<vendors-list-uuid>"
OMNIPOST_CUSTOMER_LIST_UUIDS="<customers-list-uuid>"
# Public newsletter list targeted by POST /api/updates/join (site footer + signups).
OMNIPOST_PUBLIC_LIST_UUIDS="<public-newsletter-list-uuid>"
# Omnipost base URL for server-to-server subscribe calls.
# Dev: http://localhost:9000 | VPS/docker: http://patra_app:9000
# Optional OMNIPOST_BASE_URLS (comma-separated) is tried first, in order.
OMNIPOST_BASE_URL="http://localhost:9000"

# Razorpay — key_id is public (client checkout), key_secret is SERVER-ONLY (never NEXT_PUBLIC_).
RAZORPAY_KEY_ID="rzp_test_xxxx"
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxx"

# ── Firebase (FCM web push) ───────────────────────────────────────────────
# Project: service-hub-df5e3 — Firebase Console → Project settings.
# SERVER-ONLY: base64 of the service-account JSON (Project settings → Service accounts
# → Generate new private key), e.g.:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('firebase/<sa>.json')).toString('base64'))"
# (Raw JSON or a path to the JSON file also work.) The JSON itself lives in /firebase and is gitignored.
FIREBASE_PROJECT_ID="service-hub-df5e3"
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Client Web-App config (public by design, but keep them in .env):
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="service-hub-df5e3.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="service-hub-df5e3"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="service-hub-df5e3.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Web Push certificate key: Console → Project settings → Cloud Messaging → Web Push certificates.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Public app URL — used for absolute push-notification click links (dev: http://localhost:3000,
# prod: https://www.service-hub.apnidesidukaan.com).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
