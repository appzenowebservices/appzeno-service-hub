generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  AGENT
  ADMIN
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum SubscriptionPlan {
  FREE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  fullName          String
  mobile            String    @unique
  // email is intentionally NOT unique: one person can hold CUSTOMER, VENDOR
  // and AGENT accounts on the same email address (mobile stays the login key).
  email             String?
  role              UserRole  @default(CUSTOMER)
  city              String
  state             String
  avatar            String?
  preferredLanguage String    @default("en")
  isVerified        Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  passwordHash      String?
  // FCM registration tokens for web push (one per browser/device)
  fcmTokens         String[]  @default([])
  // Mobile number verified via Firebase Phone Auth (SMS OTP)
  mobileVerified    Boolean   @default(false)
  mobileVerifiedAt  DateTime?

  customerProfile   CustomerProfile?
  vendorProfile     VendorProfile?
  agentProfile      AgentProfile?
  BookingsAsCustomer Booking[] @relation(name: "BookingsAsCustomer")
  BookingsAsVendor  Booking[] @relation(name: "BookingsAsVendor")
  CustomerReviews   Review[]  @relation(name: "CustomerReviews")
  VendorReviews     Review[]  @relation(name: "VendorReviews")
  Address           Address[]
  walletTxs         WalletTransaction[]
  notifications     Notification[]
}

model CustomerProfile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  referralCode  String?
  walletBalance Float    @default(0)
  // false until the customer confirms their email (Omnipost confirm event)
  isApproved    Boolean  @default(false)
}

model VendorProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id])
  businessName     String
  yearsOfExperience Int
  serviceCategories String[]
  serviceAreaPincodes String[]
  workingDays      String[]
  timeSlots        Json
  kycStatus        KYCStatus @default(PENDING)
  subscriptionPlan SubscriptionPlan @default(FREE)
  reliabilityScore Float    @default(0)
  rating           Float    @default(0)
  totalReviews     Int      @default(0)
  basePricing      Json
  isApproved       Boolean   @default(false)
  // ── KYC documents (UploadThing URLs, set by the vendor's own submission) ──
  aadhaarDoc       String?
  panDoc           String?
  profilePhoto     String?
  gst              String?
  kycSubmittedAt   DateTime?
  // ── Service address — drives which serving pincodes the vendor can pick ──
  streetAddress    String?
}

model AgentProfile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])
  assignedCity  String
  // pincodes the agent owns — vendors serving these pincodes fall under them
  serviceAreaPincodes String[] @default([])
  commissionPercent Float @default(5)
  officeAddress String
  gst           String?
  bankDetails   Json?
  // flipped by the Omnipost subscriber.confirmed webhook (agent list)
  isVerified    Boolean  @default(false)
  // ── Service address — drives which serving pincodes the agent can pick ──
  streetAddress String?
}

model Address {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  houseNo   String
  landmark  String?
  area      String
  pincode   String
  city      String
  lat       Float?
  lng       Float?
  isDefault Boolean @default(false)
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  name        String
  icon        String
  image       String?
  description String?
  commissionPercent Float @default(10)
  // ── storefront merchandising (all superadmin-controlled) ──
  rating        Float   @default(0)
  totalBookings Int     @default(0)
  isFeatured    Boolean @default(false)
  sortOrder     Int     @default(0)
  subCategories SubCategory[]
  isActive    Boolean  @default(true)
}

model SubCategory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String  @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  basePrice   Float
  unit        String
  isActive    Boolean @default(true)
}

model Booking {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String        @db.ObjectId
  customer      User          @relation(fields: [customerId], references: [id], name: "BookingsAsCustomer")
  vendorId      String?       @db.ObjectId
  vendor        User?         @relation(fields: [vendorId], references: [id], name: "BookingsAsVendor")
  categoryId    String
  subCategoryId String
  description   String
  images        String[]
  urgency       String        @default("normal")
  address       Json
  preferredDate String
  timeSlot      Json
  status        BookingStatus @default(PENDING)
  paymentMethod String
  paymentStatus PaymentStatus @default(PENDING)
  baseAmount    Float
  surgeAmount   Float         @default(0)
  visitingCharge Float        @default(0)
  totalAmount   Float
  // Razorpay online-payment linkage (dummy/test or live)
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Lead          Lead[]
  Review        Review[]
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId String   @db.ObjectId
  booking   Booking  @relation(fields: [bookingId], references: [id])
  vendorId  String   @db.ObjectId
  sentAt    DateTime @default(now())
  expiresAt DateTime
  status    String   @default("pending")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId String   @db.ObjectId
  booking   Booking  @relation(fields: [bookingId], references: [id])
  customerId String  @db.ObjectId
  customer  User     @relation(fields: [customerId], references: [id], name: "CustomerReviews")
  vendorId  String   @db.ObjectId
  vendor    User     @relation(fields: [vendorId], references: [id], name: "VendorReviews")
  rating    Float
  comment   String?
  reply     String?
  createdAt DateTime @default(now())
}

model WalletTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  type        String
  amount      Float
  description String
  balanceAfter Float
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  image     String?
  createdAt DateTime @default(now())
}

// ── Omnipost webhook receiver (see /webhooks/omnipost) ──
model NewsletterSubscriber {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  uuid        String    @unique
  email       String
  name        String?
  listUuids   String[]
  status      String    @default("confirmed")
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OmnipostProcessedKey {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  createdAt DateTime @default(now())
}

// ── Centralized serving areas (pincode coverage per city, admin-managed) ──
model ServingArea {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  city      String   @unique
  state     String
  lat       Float    @default(26.8467)
  lng       Float    @default(80.9462)
  isActive  Boolean  @default(true)
  pincodes  String[] @default([])
  createdAt DateTime @default(now())
}